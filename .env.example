# ─── Supabase ──────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── AI Consultant ─────────────────────────────────────────────
# Provider: "anthropic" (default) | "openai" | "ollama"
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...         # alternativă OpenAI
# OLLAMA_URL=http://localhost:11434/api/chat   # dev local
# OLLAMA_MODEL=llama3.2

# ─── Email oferte (Resend) ─────────────────────────────────────
RESEND_API_KEY=re_...
QUOTE_TO_EMAIL=office@glass.associates
QUOTE_CC_EMAIL=
QUOTE_FROM_EMAIL=oferte@glazeo.ro

# ─── Admin ────────────────────────────────────────────────────
ADMIN_PASSWORD=schimba-asta-imediat
TOKEN_SECRET=string-random-lung-min-32-chars

# ─── Sentry (opțional) ────────────────────────────────────────
# SENTRY_DSN=https://...@sentry.io/...

# ─── CORS (backend standalone) ────────────────────────────────
ALLOWED_ORIGINS=https://glazeo.ro,https://www.glazeo.ro
